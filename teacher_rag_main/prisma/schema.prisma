generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  teacher
  admin
  manager
}

enum FileSource {
  upload
  google_drive
  dropbox
  notion
  onedrive
  s3
  youtube
}

enum FileStatus {
  uploading
  processing
  ready
  error
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         Role     @default(user)
  firebaseUid  String?  @unique
  avatarUrl    String?
  isActive     Boolean  @default(true)
  termsVersion    String?
  termsAcceptedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  knowledgeBase KnowledgeBase?
  subjects      Subject[]
  files         KnowledgeFile[]
  queryLogs     QueryLog[]
  studyReviews  ExpertReview[]
  teacherChats  TeacherChatSession[]
  studyReviewerOf StudyReviewer[]

  @@map("users")
}

model Student {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String?  // nullable for google users
  firebaseUid String?  @unique
  name        String?
  avatarUrl   String?
  termsVersion    String?
  termsAcceptedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments  Enrollment[]
  queryLogs    QueryLog[]
  activityLogs ActivityLog[]
  notes        Note[]
  chatSessions ChatSession[]
  answerRatings   AnswerRating[]
  surveyResponses SurveyResponse[]
  studyConsents   StudyConsent[]

  @@map("students")
}

model Enrollment {
  id             String   @id @default(uuid())
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId      String
  totalTimeSpent Int      @default(0) // in seconds
  questionsUsed  Int      @default(0) // lifetime questions asked in this subject (enforces the per-subject cap)
  lastActiveAt   DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([studentId, subjectId])
  @@map("enrollments")
}

model ActivityLog {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  type      String   // "page_view", "time_spent", "file_open"
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

model KnowledgeBase {
  id             String   @id @default(uuid())
  teacherId      String   @unique
  teacher        User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  collectionName String   @unique @default(uuid())
  totalFiles     Int      @default(0)
  totalSizeBytes BigInt   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("knowledge_bases")
}

model Subject {
  id             String   @id @default(uuid())
  name           String
  teacherId      String
  teacher        User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classCode      String?  @unique
  collectionName String   @unique @default(uuid())
  metadata       Json?    // For any extra subject-specific config
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  files          KnowledgeFile[]
  queryLogs      QueryLog[]
  enrollments    Enrollment[]
  activityLogs   ActivityLog[]
  notes          Note[]
  chatSessions   ChatSession[]
  studyConfig    StudyConfig?
  studyReviewers StudyReviewer[]
  answerRatings   AnswerRating[]
  surveyResponses SurveyResponse[]
  studyConsents   StudyConsent[]
  expertReviews   ExpertReview[]
  teacherChats    TeacherChatSession[]

  @@unique([teacherId, name])
  @@map("subjects")
}

model KnowledgeFile {
  id           String     @id @default(uuid())
  teacherId    String
  teacher      User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  name         String
  originalName String
  displayName  String?    // Teacher-editable alias
  tags         String[]   @default([])
  mimeType     String
  sizeBytes    BigInt     @default(0)
  storagePath  String
  source       FileSource @default(upload)
  status       FileStatus @default(uploading)
  cloudFileId  String?
  chunkCount   Int        @default(0)
  errorMsg     String?
  isAssignment Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  queryLogs    QueryLog[]
  notes        Note[]

  @@map("knowledge_files")
}

// Tracks every question asked (teacher or student) for analytics
model QueryLog {
  id           String    @id @default(uuid())
  teacherId    String
  teacher      User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  question     String
  answer       String?   @db.Text
  subjectId    String?
  subject      Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  studentId    String?
  student      Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  fileId       String?   // scoped to a file? optional
  file         KnowledgeFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  askedBy      String    @default("teacher") // "teacher" | "student"
  topic        String?
  responseMs   Int?      // response time in ms
  chunkCount   Int?      // how many chunks were retrieved
  createdAt    DateTime  @default(now())

  @@map("query_logs")
}

model Note {
  id              String         @id @default(uuid())
  studentId       String
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  fileId          String?
  file            KnowledgeFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  content         String         @db.Text
  pageNumber      Int?
  selectionText   String?        @db.Text
  selectionCoords Json?          // {x, y, w, h} relative to viewport/page
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([studentId, subjectId])
  @@index([fileId])
  @@map("notes")
}

// ─── CHAT HISTORY ─────────────────────────────────────────────────────────────

model ChatSession {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String?  // auto-generated from first message
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  ChatMessage[]

  @@index([studentId, subjectId])
  @@map("chat_sessions")
}

model ChatMessage {
  id         String      @id @default(uuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ratings    AnswerRating[]
  reviews    ExpertReview[]
  role       String      // "user" | "assistant"
  content    String      @db.Text
  sources    Json?       // RAGSource[] stored as JSON
  createdAt  DateTime    @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}

// ─── JEWELLERY POS ────────────────────────────────────────────────────────────

enum Gender {
  men
  women
  unisex
}

enum Occasion {
  wedding
  daily
  party
  festival
  office
  other
}

enum ProductStatus {
  active
  inactive
}

enum MetalType {
  gold
  silver
  platinum
}

enum Purity {
  K18
  K22
  K24
}

enum MetalColor {
  yellow
  white
  rose
}

enum MakingChargeType {
  per_gram
  fixed
}

enum ItemStatus {
  available
  sold
  reserved
  damaged
  returned
}

enum ItemLocation {
  store
  warehouse
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id               Int              @id @default(autoincrement())
  name             String
  sku              String           @unique
  categoryId       Int
  category         Category         @relation(fields: [categoryId], references: [id])
  description      String?
  designCode       String?
  brand            String?
  collectionName   String?
  gender           Gender?
  occasion         Occasion?
  status           ProductStatus    @default(active)

  // Identification
  barcode          String           @unique

  // Metal Details
  metalType        MetalType?
  purity           Purity?
  metalColor       MetalColor?
  hallmarkNumber   String?

  // Weight Template (defaults)
  grossWeight      Decimal?         @db.Decimal(10, 3)
  netWeight        Decimal?         @db.Decimal(10, 3)
  stoneWeight      Decimal?         @db.Decimal(10, 3)
  wastagePercentage Decimal?        @db.Decimal(5, 2)

  // Stone Info
  hasStones        Boolean          @default(false)
  stoneType        String?
  stonePrice       Decimal?         @db.Decimal(12, 2)

  // Dimensions
  length           Decimal?         @db.Decimal(8, 2)
  width            Decimal?         @db.Decimal(8, 2)
  height           Decimal?         @db.Decimal(8, 2)
  thickness        Decimal?         @db.Decimal(8, 2)
  ringSize         String?

  // Pricing Configuration
  makingChargeType MakingChargeType?
  makingChargeRate Decimal?         @db.Decimal(10, 2)
  fixedMakingCharge Decimal?        @db.Decimal(10, 2)
  wastageChargePercentage Decimal?  @db.Decimal(5, 2)
  taxPercentage    Decimal?         @db.Decimal(5, 2)
  discountPercentage Decimal?       @db.Decimal(5, 2)
  priceOverride    Decimal?         @db.Decimal(12, 2)

  // Media
  imageUrl         String?
  thumbnailUrl     String?

  // Audit
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?

  inventoryItems   InventoryItem[]

  @@map("products")
}

model InventoryItem {
  id             Int          @id @default(autoincrement())
  productId      Int
  product        Product      @relation(fields: [productId], references: [id])
  uniqueItemCode String       @unique
  barcode        String       @unique

  // Stock Info
  quantity       Int          @default(1)
  location       ItemLocation @default(store)
  status         ItemStatus   @default(available)

  // Actual Weights
  grossWeight    Decimal?     @db.Decimal(10, 3)
  netWeight      Decimal?     @db.Decimal(10, 3)
  stoneWeight    Decimal?     @db.Decimal(10, 3)

  // Pricing Snapshot
  purchasePrice  Decimal?     @db.Decimal(12, 2)
  sellingPrice   Decimal?     @db.Decimal(12, 2)
  goldRateAtPurchase Decimal? @db.Decimal(10, 2)

  // Supplier Info
  supplierId     String?
  purchaseDate   DateTime?
  invoiceNumber  String?

  // Lifecycle
  soldAt         DateTime?
  reservedAt     DateTime?
  returnedAt     DateTime?

  // Audit
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  adjustments    InventoryAdjustment[]

  @@map("inventory_items")
}

model InventoryAdjustment {
  id            Int           @id @default(autoincrement())
  inventoryItemId Int
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  change        Int
  reason        String
  performedBy   String?
  createdAt     DateTime      @default(now())

  @@map("inventory_adjustments")
}


// ─── HUMAN EVALUATION (opt-in research study mode) ────────────────────────────
// Only students who explicitly consent are rated / exported. See STUDY_MODE.md.

model StudyConfig {
  id             String   @id @default(uuid())
  subjectId      String   @unique
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  enabled        Boolean  @default(false)
  consentText    String?  @db.Text
  consentVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("study_configs")
}

model StudyReviewer {
  id        String   @id @default(uuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([subjectId, userId])
  @@map("study_reviewers")
}

model StudyConsent {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  consentVersion Int
  agreed         Boolean
  createdAt      DateTime @default(now())

  @@unique([studentId, subjectId, consentVersion])
  @@map("study_consents")
}

// One student's rating of one assistant answer.
model AnswerRating {
  id              String      @id @default(uuid())
  messageId       String
  message         ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  helpful         Int         // 1-5
  citationSupport String?     // "yes" | "partly" | "no" | "none"
  comment         String?     @db.Text
  createdAt       DateTime    @default(now())

  @@unique([messageId, studentId])
  @@index([subjectId])
  @@map("answer_ratings")
}

// "sus" (10 items) or "usefulness" (8 items); answers are 1-5 Likert values in item order.
model SurveyResponse {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  instrument String
  answers    Json
  score      Float?   // SUS 0-100, usefulness mean 1-5
  createdAt  DateTime @default(now())

  @@unique([studentId, subjectId, instrument])
  @@map("survey_responses")
}

// Expert rating of one assistant answer (rubric of Appendix B.3, 1-5 each).
model ExpertReview {
  id               String      @id @default(uuid())
  messageId        String
  message          ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reviewerId       String
  reviewer         User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  relevance        Int
  factualAccuracy  Int
  groundingQuality Int
  educationalValue Int
  citationQuality  Int?        // null when the answer has no citations
  revealedSolution Boolean?    // assignment-related answers only
  notes            String?     @db.Text
  createdAt        DateTime    @default(now())

  @@unique([messageId, reviewerId])
  @@index([subjectId])
  @@map("expert_reviews")
}


// ─── TEACHER CHAT HISTORY (teachers testing the assistant on their own materials) ─────────

model TeacherChatSession {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  TeacherChatMessage[]

  @@index([teacherId, subjectId])
  @@map("teacher_chat_sessions")
}

model TeacherChatMessage {
  id        String             @id @default(uuid())
  sessionId String
  session   TeacherChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String             // "user" | "assistant"
  content   String             @db.Text
  sources   Json?
  createdAt DateTime           @default(now())

  @@index([sessionId])
  @@map("teacher_chat_messages")
}
