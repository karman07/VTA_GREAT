# ── TeachAI RAG service (Gemini + embedded Qdrant) ──────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-2.5-flash-lite
VISION_MODEL_NAME=gemini-2.5-flash-lite
EMBED_MODEL_NAME=gemini-embedding-001
EMBED_DIM=768

# Local vector store (Qdrant embedded mode — single process, no server)
QDRANT_PATH=./qdrant_data

# NestJS backend uploads directory
UPLOADS_ROOT=../backend/uploads

RAG_HOST=0.0.0.0
RAG_PORT=8000
PDF_MAX_PAGES=20
PDF_MAX_IMAGES_PER_PAGE=10
PDF_MIN_IMAGE_AREA=40000
PDF_VISION_CONCURRENCY=10
